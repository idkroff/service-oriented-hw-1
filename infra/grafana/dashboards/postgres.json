{
  "annotations": {"list": []},
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "uid": "postgres-infra",
  "title": "PostgreSQL Infrastructure",
  "tags": ["infrastructure", "postgres"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {"from": "now-30m", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Active connections by database",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (datname) (pg_stat_database_numbackends{datname=~\"marketplace|user_service\"})",
          "legendFormat": "{{datname}}"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "short", "custom": {"drawStyle": "line", "lineWidth": 2}},
        "overrides": []
      },
      "options": {"legend": {"showLegend": true, "displayMode": "table"}}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Cache hit ratio (по БД)",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (datname) (rate(pg_stat_database_blks_hit{datname=~\"marketplace|user_service\"}[5m])) / (sum by (datname) (rate(pg_stat_database_blks_hit{datname=~\"marketplace|user_service\"}[5m])) + sum by (datname) (rate(pg_stat_database_blks_read{datname=~\"marketplace|user_service\"}[5m])))",
          "legendFormat": "{{datname}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 4,
          "custom": {"drawStyle": "line"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 0.9},
              {"color": "green", "value": 0.99}
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Transactions/sec (commits)",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (datname) (rate(pg_stat_database_xact_commit{datname=~\"marketplace|user_service\"}[1m]))",
          "legendFormat": "{{datname}} commits"
        },
        {
          "refId": "B",
          "expr": "sum by (datname) (rate(pg_stat_database_xact_rollback{datname=~\"marketplace|user_service\"}[1m]))",
          "legendFormat": "{{datname}} rollbacks"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "ops", "custom": {"drawStyle": "line"}},
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Deadlocks / temp files (узкие места)",
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (datname) (rate(pg_stat_database_deadlocks{datname=~\"marketplace|user_service\"}[5m]))",
          "legendFormat": "{{datname}} deadlocks"
        },
        {
          "refId": "B",
          "expr": "sum by (datname) (rate(pg_stat_database_temp_files{datname=~\"marketplace|user_service\"}[5m]))",
          "legendFormat": "{{datname}} temp files"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "ops", "custom": {"drawStyle": "bars", "fillOpacity": 80}},
        "overrides": []
      }
    }
  ]
}
